# ── build ────────────────────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY tsconfig*.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

# ── runtime ──────────────────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV CHROMIUM_PATH=/usr/bin/chromium

# The worker carries the heavy tail: ffmpeg for render and encode, fonts for
# drawtext (Chromium and its font set join at M6 with the Playwright renderer).
# fonts-liberation covers the fallback; Kalam is vendored so the CSP-constrained
# page never needs a network fetch.
# Chromium for the Playwright renderer. Debian's package rather than a
# Playwright-downloaded build: `playwright-core` ships no browser, and pulling
# one at build time would add a vendor CDN to the supply chain for a binary
# apt already provides. Kalam is vendored under assets/ for the same reason —
# the page runs with every outbound request blocked.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ffmpeg \
      chromium \
      fonts-liberation \
      tini \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY config ./config
# Prompts are read at runtime from PROMPT_DIR, and verifyAll() checks them at
# boot — without this the image starts fine on stubs and dies the moment a real
# LLM driver is selected.
COPY prompts ./prompts
COPY assets ./assets

RUN useradd --system --uid 10001 --create-home appuser \
 && mkdir -p /workspace/jobs /workspace/artifacts \
 && chown -R appuser:appuser /app /workspace
USER appuser

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/interfaces/worker/worker.js"]
